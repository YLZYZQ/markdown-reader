{
  "name": "md-reader",
  "version": "1.9.0",
  "description": "Markdown阅读器",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:renderer": "esbuild build-bundle.js --bundle --minify --platform=browser --outfile=renderer/tui-editor/editor-bundle.js",
    "test": "node scripts/check-open-source-notices.js && node --test test/*.test.js",
    "notices:check": "node scripts/check-open-source-notices.js",
    "notices:update": "node scripts/update-third-party-license-inventory.js",
    "test:smoke": "electron test/smoke-electron.js",
    "test:print": "electron test/print-pipeline.electron.js",
    "dist": "electron-builder --win",
    "dist:installer": "node scripts/build-windows-installer.js",
    "dist:portable": "node scripts/build-windows-portable.js",
    "dist:dir": "electron-builder --win --dir",
    "test:reading": "electron test/reading-electron.js",
    "test:search": "electron test/search-electron.js",
    "test:link": "electron test/link-electron.js",
    "test:close": "electron test/close-electron.js",
    "test:multi-window": "electron test/multi-window-electron.js",
    "test:sidebar": "electron test/sidebar-electron.js",
    "test:help": "electron test/help-electron.js",
    "test:menu-language": "electron test/menu-language-electron.js"
  },
  "dependencies": {
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.1.0",
    "mermaid": "^11.16.1",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.1",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.local.mdreader",
    "productName": "Markdown阅读器",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES.md",
      "lib/**/*",
      "renderer/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "Markdown阅读器"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "${productName}",
      "deleteAppDataOnUninstall": false
    }
  }
}
